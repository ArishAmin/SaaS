# Supabase project configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional override for JWKS (if your Supabase instance differs)
SUPABASE_JWKS_URL=

# Redis URL for rate limiting (and later async jobs)
REDIS_URL=redis://localhost:6379

# SlowAPI rate limits
RATE_LIMIT_PER_MINUTE=30/minute

# Instant analyzer limits (DoS safety)
INSTANT_MAX_ROWS=10000
INSTANT_MAX_COLUMNS=200

# Storage cleanup
AUTO_DELETE_AFTER_ANALYSIS=true

# TTL cleanup (scheduled via Celery beat)
TTL_CLEANUP_ENABLED=false
TTL_CLEANUP_INTERVAL_MINUTES=60
DATASET_TTL_HOURS=168
SHARED_REPORT_TTL_HOURS=720

# AI assistant (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

